# Alamat listen HTTP
MAILCORE_ADDR=:8080
# API key untuk aplikasi klien (pisahkan dengan koma). WAJIB diisi di production.
MAILCORE_API_KEYS=ganti-dengan-key-acak-panjang
# debug | info | warn | error
MAILCORE_LOG_LEVEL=info

# Batas request
MAILCORE_MAX_BODY_BYTES=26214400
MAILCORE_MAX_RECIPIENTS_PER_EMAIL=50
MAILCORE_MAX_BULK_RECIPIENTS=5000
MAILCORE_MAX_BULK_CONCURRENCY=10
MAILCORE_MAX_RETRIES=5

# Antrian job bulk
MAILCORE_JOB_WORKERS=4
MAILCORE_JOB_QUEUE_SIZE=100
MAILCORE_JOB_TTL=24h

# SMTP
MAILCORE_SMTP_TIMEOUT=30s
MAILCORE_HELO_NAME=mail.example.com

# Kunci HMAC untuk tanda tangan callback (header X-Mailcore-Signature)
MAILCORE_CALLBACK_SECRET=
